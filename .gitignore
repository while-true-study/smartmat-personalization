# ---------------------------------------------------------------------------
# RAW DATA — never commit (docs/DATA_POLICY.md)
# Everything under data/raw/ is ignored, including subfolders. The only exception is
# data/raw/README.md (policy text, no raw filenames or identifiers; DECISIONS D-011).
# ---------------------------------------------------------------------------
/스마트 매트 데이터 정리/
/data/raw/*
!/data/raw/README.md

# ---------------------------------------------------------------------------
# Derived data — regenerable, not committed. Exception: the raw file manifest
# (paths + SHA-256 only) is the provenance anchor and IS committed.
# ---------------------------------------------------------------------------
/data/interim/*
!/data/interim/.gitkeep
!/data/interim/manifest/
/data/interim/manifest/*
!/data/interim/manifest/raw_file_manifest.csv
!/data/interim/manifest/raw_file_manifest.meta.json
# canonical_v1 manifests (small, no values, no absolute paths); the Parquet data under canonical_v1/ stay local
!/data/interim/manifest/canonical_v1_manifest.csv
!/data/interim/manifest/canonical_v1_summary.csv
!/data/interim/manifest/canonical_v1_file_manifest.csv
!/data/interim/manifest/canonical_v1_content.json
!/data/interim/manifest/canonical_v1_build.json
/data/processed/*
!/data/processed/.gitkeep
# P9 external-validation artifact (D-061): values stay local; only the small manifest is committed
/data/external/*
!/data/external/.gitkeep
!/data/external/p9_user03_v1_manifest.json
/data/splits/*
!/data/splits/.gitkeep
# protocol v1.0 split definitions are committed: group assignments and time spans only, no sensor or target
# values (D-042)
!/data/splits/v1.0_loso/
!/data/splits/v1.0_personalization/
!/data/splits/v1.0_manifest.json
# public release packages (D-050): the window data are rebuilt byte-for-byte by scripts/build_public_release.py and
# distributed outside Git; only the small metadata files are committed
/data/release/*/windows.parquet

# ---------------------------------------------------------------------------
# Generated outputs (QA reports, metrics, predictions, checkpoints, figures)
# ---------------------------------------------------------------------------
/outputs/*/*
!/outputs/*/.gitkeep

# Restricted participant metadata must never leave the raw package
*.xlsx
*.xls
# Exception: the supplementary-table workbook of the final submission (built from the committed P16 supplementary CSVs;
# no participant metadata)
!/paper/submission_final/supplementary/Supplementary_Tables_S1-S44.xlsx

# Python / tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.env
*.egg-info/

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# LaTeX build artefacts (paper/)
*.aux
*.log
*.out
*.synctex.gz
*.bbl
*.blg
*.fdb_latexmk
*.fls

# Final submission build intermediates (rendered PDFs and page images for visual QA)
paper/submission_final/work/
