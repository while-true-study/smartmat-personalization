{
  "release_version": "public_release_v1",
  "file": "windows.parquet",
  "columns": [
    {
      "column": "window_index",
      "dtype": "int64",
      "unit": "",
      "range": "0 ... n-1",
      "role": "order",
      "meaning": "canonical first-row order; P3/P4/P5 keep this order"
    },
    {
      "column": "subject_id",
      "dtype": "string",
      "unit": "",
      "range": "User01, User02, User07",
      "role": "grouping",
      "meaning": "anonymous subject (DATA_POLICY §3)"
    },
    {
      "column": "device_id",
      "dtype": "string",
      "unit": "",
      "range": "unknown, 22480, 22482",
      "role": "grouping",
      "meaning": "mat hardware id; 22480 and 22482 are two mats of User02 (one subject)"
    },
    {
      "column": "session_id",
      "dtype": "string",
      "unit": "",
      "range": "<subject>|<device>|S####",
      "role": "grouping",
      "meaning": "canonical session (D-024)"
    },
    {
      "column": "sensor_phase",
      "dtype": "string",
      "unit": "",
      "range": "s1, s2, not_applicable",
      "role": "stratum",
      "meaning": "User01 sensor phase (D-019)"
    },
    {
      "column": "channel_quality_phase",
      "dtype": "string",
      "unit": "",
      "range": "normal, p1_transition, p1_response_shift",
      "role": "stratum",
      "meaning": "22482 channel-quality phase (D-022)"
    },
    {
      "column": "night_id",
      "dtype": "string",
      "unit": "",
      "range": "D####",
      "role": "grouping",
      "meaning": "relative night day of the target row (D-049)"
    },
    {
      "column": "night_ordinal",
      "dtype": "int16",
      "unit": "",
      "range": "1 ... N",
      "role": "grouping",
      "meaning": "chronological subject-night number (D-037)"
    },
    {
      "column": "window_start_time_s",
      "dtype": "int64",
      "unit": "s",
      "range": ">= 0",
      "role": "time",
      "meaning": "window start t0, seconds since the subject anchor"
    },
    {
      "column": "target_time_s",
      "dtype": "int64",
      "unit": "s",
      "range": ">= 0",
      "role": "time",
      "meaning": "time of the target row (last step), same anchor"
    },
    {
      "column": "in_loso",
      "dtype": "bool",
      "unit": "",
      "range": "",
      "role": "membership",
      "meaning": "window of the D-032 LOSO window set (P3/P4)"
    },
